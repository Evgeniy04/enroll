    "react-dom",
    "@enroll/env",
    "better-auth",
    "dotenv",
    "expo-image",
    "expo-symbols",
    "zod"
  ],
  "ignoreIssues": {
    "apps/native/src/components/ui/**": ["exports", "types"]
  }
}
