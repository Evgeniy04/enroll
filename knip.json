{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "tags": ["-lintignore"],
  "workspaces": {
    ".": {},
    "apps/native": {
      "metro": { "config": [] },
      "ignore": ["metro.config.js", "babel.config.js"]
    }
  },
  "ignoreDependencies": [
    "@react-email/preview-server",
    "@types/react-dom",
    "simple-git-hooks",
