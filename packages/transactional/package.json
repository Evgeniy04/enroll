{
  "name": "@enroll/transactional",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/emails/*.tsx"
    }
  },
  "scripts": {
    "emailbuild": "email build -d ./src",
    "emaildev": "email dev -d ./src -p 3001",
    "export": "email export -d ./src",
    "start": "email start -d ./src -p 3001"
  },
  "dependencies": {
    "@react-email/components": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@react-email/preview-server": "5.2.7",
    "@types/node": "25.0.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "react-email": "5.2.7"
  }
}
