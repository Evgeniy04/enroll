{
  "name": "enroll",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @enroll/db db:push",
    "db:studio": "turbo -F @enroll/db db:studio",
    "db:generate": "turbo -F @enroll/db db:generate",
    "db:migrate": "turbo -F @enroll/db db:migrate",
    "db:start": "turbo -F @enroll/db db:start",
    "db:watch": "turbo -F @enroll/db db:watch",
    "db:stop": "turbo -F @enroll/db db:stop",
    "db:down": "turbo -F @enroll/db db:down",
    "setup": "bash scripts/setup.sh",
    "knip": "dotenv -e apps/server/.env -- knip"
  },
  "dependencies": {
    "@enroll/env": "workspace:*",
    "dayjs": "catalog:",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@enroll/config": "workspace:*",
    "@types/node": "^22.13.14",
    "knip": "^5.83.0",
    "turbo": "^2.6.3",
    "typescript": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "simple-git-hooks",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.28.2"
}
